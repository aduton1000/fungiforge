// Per-stage labels -> conda env + container image + resources.
// params.fungiforge_image / params.antismash_image are read at config-parse time, so they
// can be overridden on the CLI (--fungiforge_image) but NOT from a `-c` file. A site
// config points the labels at local .sif files directly (see share/site.config.example).
// Nextflow picks `container` when a docker/singularity/apptainer profile is on,
// otherwise `conda`. Images are linux/amd64 (native on x86_64 Linux; emulated on arm64 hosts).
//
// Image pins (W0.2). Every public image is a versioned tag (literal strings: bin/fetch_references.sh
// greps them to pre-pull the cache), and the manifest-list digest each tag resolved to when it was
// validated is recorded here so a tag that is later re-pushed can be detected — provenance.json records
// the digest/sha256 of what actually ran. funannotate has no versioned tag for the validated build
// (1.8.17.dev197), so it is pinned by digest directly.
//   staphb/flye:2.9.6            sha256:1d5f3d3a9069fab02ab06d0a749692db281ae80d089bbf5770488dfa9c6229c0  flye 2.9.6
//   staphb/spades:4.3.0          sha256:6de15dfdc9680cf9dc81200f78f16359f5d3d028945fbc898f4fdb5a6a561eb9  SPAdes 4.3.0
//   staphb/medaka:2.2.2          sha256:be8deb0b6e901a0665e357ff3e7c16f108a4df96da2813ca44ff2fcd36a11b48  medaka 2.2.2
//   staphb/polypolish:0.6.1-bwa  sha256:fbeab76d26e798edae701c903f485b5eb9f69026260c5148a4b83e47ed5be8ba  Polypolish 0.6.1 + bwa (stage 03b needs bwa)
//   ezlabgva/busco:v5.7.1_cv1    sha256:17d01550135a279596041a01f17caf47a3fd0883ad8359e23cea543044db7ce2  BUSCO 5.7.1
//   dfam/tetools:2.00            sha256:6081b4d3883eff478873cb94cd24addf540275365d4acc4446bb647a341e95e2  RepeatModeler 2.0.9 / RepeatMasker 4.2.4 (1.99 ships 2.0.8/4.2.3)
//   nextgenusfs/funannotate@sha256:2eadfeb4…  funannotate 1.8.17.dev197+g456b08d, Augustus 3.4.0 (validated on CEA10 / DF-005)
//   quay.io/biocontainers/eggnog-mapper:2.1.15--pyhdfd78af_0  sha256:f70babaf681ff4b6b2fc8e8e76754bf989f01dd4910ca91f156c22aa88ea70d3  eggNOG-mapper 2.1.15 (W2.5, stage 07b)
//   interpro/interproscan:5.78-109.0  sha256:dc58b7c147fbbf00c2dd4f5ced42121fc1e8841fcbc7cc2c484380248ff76d11  InterProScan 5.78-109.0 (W2.5, stage 07c; data release staged separately)
// To re-verify a tag:  curl -s https://hub.docker.com/v2/repositories/<repo>/tags/<tag> | jq .digest
process {
  withLabel: readqc     { conda = "${projectDir}/env/readqc.yml";     container = params.fungiforge_image;           cpus = 4;  memory = 16.GB; time = 6.h  }
  withLabel: basecall   { conda = "${projectDir}/env/readqc.yml";     container = params.fungiforge_image;                               cpus = 8;  memory = 16.GB; time = 24.h }  // Dorado runs native arm64 on host
  withLabel: assembly   { conda = "${projectDir}/env/assembly.yml";   container = 'staphb/flye:2.9.6';                     cpus = { Math.min(12, params.max_cpus as int) }; memory = 64.GB; time = 24.h }
  withLabel: srassembly { conda = "${projectDir}/env/srassembly.yml"; container = 'staphb/spades:4.3.0';                     cpus = { Math.min(12, params.max_cpus as int) }; memory = 64.GB; time = 24.h }  // Illumina-only assembly (SPAdes/MEGAHIT)
  withLabel: polish     { conda = "${projectDir}/env/polish.yml";     container = 'staphb/medaka:2.2.2';                     cpus = { Math.min(8, params.max_cpus as int) };  memory = 32.GB; time = 12.h }
  withLabel: srpolish   { conda = "${projectDir}/env/srpolish.yml";   container = 'staphb/polypolish:0.6.1-bwa';                     cpus = { Math.min(8, params.max_cpus as int) };  memory = 32.GB; time = 8.h  }
  withLabel: decontam   { conda = "${projectDir}/env/decontam.yml";   container = params.fungiforge_image;            cpus = 8;  memory = 32.GB; time = 8.h  }
  withLabel: busco      { conda = "${projectDir}/env/busco.yml";      container = 'ezlabgva/busco:v5.7.1_cv1';                     cpus = 8;  memory = 24.GB; time = 8.h  }
  withLabel: repeat     { conda = null;                               container = 'dfam/tetools:2.00';                     cpus = { Math.min(12, params.max_cpus as int) }; memory = 48.GB; time = 48.h }
  withLabel: annotate   { conda = null;                               container = 'nextgenusfs/funannotate@sha256:2eadfeb46368052d8862ff3851a8af88f3468308824245fe83de68669fb3803b';                    cpus = { Math.min(12, params.max_cpus as int) }; memory = 64.GB; time = 72.h }
  withLabel: eggnog     { conda = null;                               container = 'quay.io/biocontainers/eggnog-mapper:2.1.15--pyhdfd78af_0'; cpus = { Math.min(12, params.max_cpus as int) }; memory = 48.GB; time = 24.h }
  withLabel: interproscan { conda = null;                             container = 'interpro/interproscan:5.78-109.0';       cpus = { Math.min(16, params.max_cpus as int) }; memory = 64.GB; time = 48.h }
  withLabel: identify   { conda = "${projectDir}/env/identify.yml";   container = params.fungiforge_image;                               cpus = 6;  memory = 24.GB; time = 8.h  }
  withLabel: resistance { conda = "${projectDir}/env/resistance.yml"; container = params.fungiforge_image;                               cpus = 4;  memory = 16.GB; time = 6.h  }
  withLabel: mge        { conda = "${projectDir}/env/mge.yml";        container = params.fungiforge_image;                               cpus = 6;  memory = 24.GB; time = 12.h }
  // antismash image ENTRYPOINT is cleared in the docker profile (nextflow.config); not needed for apptainer.
  withLabel: bgc        { conda = "${projectDir}/env/bgc.yml";        container = params.antismash_image;  cpus = 6;  memory = 24.GB; time = 12.h }  // antismash/standalone:8.0.0 + procps + writable module data dirs (see env/antismash-ff.Dockerfile)
  withLabel: extras     { conda = "${projectDir}/env/extras.yml";     container = params.fungiforge_image;                               cpus = 4;  memory = 16.GB; time = 8.h  }
  withLabel: cohort     { conda = "${projectDir}/env/identify.yml";   container = params.fungiforge_image;                               cpus = { Math.min(16, params.max_cpus as int) }; memory = 48.GB; time = 48.h }
  withLabel: report     { conda = "${projectDir}/env/fungiforge.yml"; container = params.fungiforge_image;                               cpus = 2;  memory = 8.GB;  time = 4.h  }
}
