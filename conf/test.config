// Synthetic / subsampled fixture — exercises the full 15-stage DAG end-to-end in
// minutes via `-stub-run` (machinery check, NOT a data-quality check).
//   nextflow run main.nf -profile test,docker -stub-run
params {
  samplesheet   = "${projectDir}/test/samplesheet.test.csv"
  outdir        = 'results_test'
  data_dir      = "${projectDir}/test/mini_db"
  busco_lineage = 'saccharomycetes_odb10'
  run_interproscan = false
  hybrid        = 'auto'
}
