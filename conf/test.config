// Synthetic / subsampled fixture — exercises the full 15-stage DAG end-to-end in
// minutes via `-stub-run` (machinery check, NOT a data-quality check).
//   nextflow run main.nf -profile test,docker -stub-run
params {
  samplesheet   = "${projectDir}/test/samplesheet.test.csv"
  outdir        = 'results_test'
  data_dir      = "${projectDir}/test/mini_db"
  busco_lineage = 'saccharomycetes_odb10'
  run_interproscan = false
  hybrid        = 'auto'
  allow_missing_db = true      // test/mini_db is empty: DB_CHECK warns instead of failing
  provenance_hash_images = false
}

// The machinery check must run on a laptop or a 4-core / 16 GB CI runner: cap every stage's
// request (the per-label values in conf/base.config are sized for real genomes). Nextflow
// clamps cpus/memory/time to these limits before the local executor checks availability.
process {
  resourceLimits = [ cpus: 2, memory: 4.GB, time: 2.h ]
}
