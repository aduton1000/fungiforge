// SLURM execution overrides (loaded by the hpc_slurm profile). Partition routing is
// time-based by default; override with --slurm_partition / --slurm_account.
params {
  slurm_partition = null
  slurm_account   = null
}
process {
  executor       = 'slurm'
  queue          = { params.slurm_partition ?: (task.time <= 4.h ? 'short' : 'long') }
  clusterOptions = { params.slurm_account ? "--account=${params.slurm_account}" : '' }
}
executor {
  queueSize       = 100
  submitRateLimit = '10/1min'
}
