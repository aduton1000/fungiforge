// SLURM execution overrides (loaded by the hpc_slurm profile).
// Partition: --slurm_partition <name> (or FUNGIFORGE_PARTITION in the site env). When unset
// the job is submitted WITHOUT -p, i.e. to the cluster's default partition (sinfo shows it
// with a *). Account: --slurm_account. Per-site caps/images: a site config passed with -c
// (see share/site.config.example) — never edit this file for one cluster.
params {
  slurm_partition = null
  slurm_account   = null
}
process {
  executor       = 'slurm'
  queue          = { params.slurm_partition ?: null }
  clusterOptions = { params.slurm_account ? "--account=${params.slurm_account}" : '' }
}
executor {
  queueSize       = 100
  submitRateLimit = '10/1min'
  pollInterval    = '30 sec'
  queueStatInterval = '2 min'
}
