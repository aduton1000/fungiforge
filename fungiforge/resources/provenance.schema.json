                           "user": {"type": ["string", "null"]}, "host": {"type": ["string", "null"]}}},
    "params": {"type": "object"},
    "containers": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "images": {"type": "object",
               "additionalProperties": {"type": "object", "required": ["reference", "engine", "resolved"],
