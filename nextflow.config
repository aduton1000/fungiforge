// FungiForge — Nextflow configuration
// Two composable profile groups (mirrors CallForge / MethylForge):
//   execution : local | hpc_slurm
//   packaging : conda | mamba | docker | singularity | apptainer
// e.g.  -profile local,docker            (single machine; arm64 hosts run linux/amd64 images under emulation)
//       -profile hpc_slurm,singularity   (SLURM cluster; native)

manifest {
  name            = 'fungiforge'
  author          = 'aduton1000'
  description     = 'Reproducible fungal genomics from ONT, Illumina, or ONT+Illumina hybrid: assembly, eukaryotic annotation, ITS/genome identification, antifungal-resistance calling, mobile/TE/mycovirus, biosynthetic gene clusters, novelty, and One Health comparative analysis.'
  version         = '0.2.0'
  nextflowVersion = '>=23.10'
}

params {
  help          = false
  // ---- inputs ----
  samplesheet   = null   // CSV: sample,ont_fastq,illumina_r1,illumina_r2,compartment,facility,season
  outdir        = 'results'
  data_dir      = null   // reference-database root (see bin/fetch_references.sh); e.g. an external drive

  // ---- read handling ----
  ont_min_qual  = 10     // chopper Q filter
  ont_min_len   = 1000   // chopper length filter
  hybrid        = 'auto' // auto (use Illumina if present) | on | off  -> Stage 03 polishing (long-read isolates)
  basecall      = false  // true: run Dorado on pod5 input (ont_fastq column = pod5 dir)
  dorado_model  = 'r1041_e82_400bps_sup_v5.2.0'
  medaka_model  = null   // medaka model for reads whose headers carry no basecall model (default: the dorado_model string);
                         // reads basecalled by Dorado are resolved automatically from their headers
  dorado_duplex = false

  // ---- assembly / QC ----
  // assembler   = long-read assembler for ONT / hybrid isolates.
  // sr_assembler= short-read assembler for Illumina-only isolates (no ONT).
  // Each isolate is routed automatically by meta.assembly_mode (see main.nf).
  assembler     = 'flye'   // flye | canu | raven   (long-read)
  sr_assembler  = 'spades' // spades | megahit       (Illumina-only)
  purge_dups    = true     // long-read haplotig purging (skipped for short-read assemblies)
  min_contig_len = 500     // drop contigs shorter than this (and any with <4 distinct bases) before QC/annotation:
                           // short-read assemblers leave thousands of tiny fragments and occasional homopolymer
                           // stubs that funannotate refuses to annotate. Also passed to `funannotate sort --minlen`.
  busco_lineage = 'auto' // auto (order-specific after ID) | fungi_odb10 | <lineage>

  // ---- annotation ----
  genemark_key  = null   // path to a (free academic) GeneMark licence key (gm_key); needs --genemark_dir too.
                         // Its DIRECTORY is bound into the container: the key normally sits beside the
                         // unpacked GeneMark directory rather than inside it.
  genemark_dir  = null   // W2.5: unpacked GeneMark-ES directory (gmes_petap.pl); licensed, not in the image; bound into the container
  annotation_training_map = "${projectDir}/fungiforge/resources/annotation_training.tsv" // species -> Augustus seed species + BUSCO set
  predict_extra = null   // extra arguments appended to `funannotate predict`
  annotate_extra = null  // extra arguments appended to `funannotate annotate`
  skip_eggnog   = false  // W2.5: stage 07b eggNOG-mapper (skipped inside the stage when the data are not staged)
  eggnog_db     = null   // override the eggNOG data directory (default <data_dir>/eggnog)
  eggnog_tax_scope = 4751 // emapper --tax_scope (4751 = Fungi)
  interproscan_data = null // W2.5: InterProScan data directory; default <data_dir>/interproscan/data
                           // (the stable symlink fetch_references.sh writes). Bound at /opt/interproscan/data.
  interproscan_apps = null // optional -appl list for interproscan.sh (default: all member databases)
  funannotate_seed  = 'anidulans' // fallback Augustus species when the map has no entry for the call
                                  // and when annotation_training.py cannot run (stage 07a)
  funannotate_busco = 'dikarya' // funannotate --busco_db SET name (dikarya|fungi|…); ships with the funannotate DB. NOT a BUSCO lineage (fungi_odb10) nor an Augustus species.
  funannotate_db = null  // override FUNANNOTATE_DB location. MUST be a SPACE-FREE path: funannotate's embedded BUSCO2 passes Augustus profile (.prfl) paths UNQUOTED, so a space (e.g. an external-drive mount path containing spaces) makes Augustus see 2 files -> 0 BUSCOs -> 0 genes. Defaults to <data_dir>/funannotate.
  antismash_db  = null   // override the antiSMASH --databases location. MUST be SPACE-FREE: antiSMASH passes DB paths to blastp UNQUOTED, so a space breaks comparippson/knownclusterblast. Defaults to <data_dir>/antismash.
  run_interproscan = false  // W2.5: stage 07c InterProScan in its own image (heavy; needs --interproscan_data)
  genome_id     = false     // Stage 08 genome-level sourmash gather (slow under emulation); ITS/UNITE is the primary ID
  // ---- identification (W2.3): secondary loci + species-aware BUSCO ----
  marker_proteins   = "${projectDir}/fungiforge/resources/markers/marker_reference_proteins.faa" // tblastn queries locating CaM/BenA/TEF1/RPB2
  marker_flank      = 300     // bp of flank kept around each extracted locus
  busco_lineage_map = "${projectDir}/fungiforge/resources/busco_lineages.tsv" // species/genus -> odb10 lineage for stage 08b
  stub_busco_lineage = null   // stub-run hook: lineage the IDENTIFY stub reports
  ploidy        = 'auto'

  // ---- organelle (W2.7) ----
  mito_proteins = "${projectDir}/fungiforge/resources/mito/mito_core_proteins.faa" // tblastn queries: 15 core genes, three fungal mitogenomes
  mito_rrna     = "${projectDir}/fungiforge/resources/mito/afum_mito_rrna.fna"     // rnl/rns for blastn
  mito_max_len  = 250000     // contigs longer than this are never called mitochondrial
  organelle_reads_check = true // map a read subsample to the mitogenome for copy number and heteroplasmy
  organelle_reads = 1000000  // Illumina pairs in that subsample
  organelle_reads_ont = 50000 // ONT reads in that subsample
  organelle_pileup_depth = 300 // target depth of the heteroplasmy pileup: the mitochondrial reads are downsampled to
                               // about this many x (0 = no downsampling, use every mapped read; raise on large-memory nodes)

  // ---- reporting (W3.3) ----
  master_schema = "${projectDir}/fungiforge/resources/master_schema.json"  // the Layer-2 contract for master_fungi.tsv

  // ---- BGC (W3.2) ----
  antismash_extra = '--cb-knownclusters'   // extra antiSMASH flags; KnownClusterBlast (MIBiG) feeds the mycotoxin flags
  mycotoxin_compounds = "${projectDir}/fungiforge/resources/mycotoxin_compounds.tsv"

  // ---- cohort phylogenomics + clonality (W3.1, run-level stage 16) ----
  skip_cohort   = false
  cohort_min_frac = 0.8      // a BUSCO gene joins the supermatrix when single-copy in this fraction of isolates
  cohort_min_isolates = 4    // tree needs at least this many isolates with BUSCO proteins
  cohort_max_genes = 500     // cap on genes in the supermatrix (runtime)
  cohort_tree_method = 'iqtree' // iqtree (IQ-TREE 3, LG+G, 1000 UFBoot) | fasttree
  cohort_ani_cluster = 95    // ANI (%) single-linkage threshold for species clusters
  clonal_snp_threshold = 100 // core SNVs at or below which two same-cluster isolates are one clonal group
  gcf_min_similarity = 0.5   // W3.2: fraction of a region's proteins shared (DIAMOND homologues) to join a gene-cluster family
  gcf_min_pident = 50        // identity floor for a shared protein (shared-protein fallback)
  gcf_method   = 'auto'      // auto (BiG-SCAPE when it and Pfam are available, else shared proteins) | bigscape | shared_proteins
  gcf_cutoff   = 0.3         // BiG-SCAPE distance cutoff for gene-cluster families

  // ---- novelty (W2.9) ----
  novelty_min_af = 15        // skani aligned fraction (%) a reference needs before its ANI counts

  // ---- mobile elements (W2.8) ----
  genomad       = true       // stage 10 geNomad on the whole assembly (skipped inside the stage without <data_dir>/genomad_db)
  genomad_splits = 8         // geNomad --splits (memory)
  rvdb_evalue   = '1e-10'    // DIAMOND blastx E-value against RVDB-prot
  rvdb_sensitivity = ''      // extra DIAMOND flag, e.g. '--sensitive' (default: fast mode)

  // ---- resistance ----
  af_panel      = "${projectDir}/fungiforge/resources/af_resistance_panel.tsv"
  read_genotype = true      // W2.4: re-genotype the hotspots from a read subsample mapped to the annotation
  genotype_reads = 3000000  // Illumina pairs in the subsample (~30x of a 30 Mb genome)
  genotype_reads_ont = 200000 // ONT reads in the subsample
  genotype_min_reads = 10   // reads covering a hotspot codon for a read-level call
  genotype_min_frac  = 0.8  // allele fraction for a homozygous call / TR present-absent

  // ---- read triage + k-mer profile (W2.2) ----
  read_triage   = true   // Kraken2 on a read subsample before assembly; non_fungal/human isolates stop there
  triage_reads  = 200000 // reads (pairs) in the triage subsample
  kmer_profile  = true   // KMC + GenomeScope2: genome size, heterozygosity, ploidy hint, coverage
  kmer_k        = 21
  stub_read_verdicts = null  // stub-run only: 'SAMPLE=non_fungal' forces triage verdicts (nf-test)

  // ---- gate (W2.1): after decontamination + assembly QC ----
  force_all     = false  // true: run the fungal stages 06-13 even for isolates the gate would stop
                         // (Kraken2 verdict non_fungal/human, or qc_pass false)
  stub_verdicts = null   // stub-run only: 'SAMPLE=non_fungal,SAMPLE2=human' forces decontam verdicts (nf-test)
  stub_qc_fail  = null   // stub-run only: 'SAMPLE,SAMPLE2' forces qc_pass=false (nf-test)

  // ---- stage toggles (skip anything not wanted) ----
  skip_decontam    = false
  skip_mge         = false
  skip_bgc         = false
  skip_novelty     = false
  skip_extras      = false

  // ---- databases and provenance (W0.2) ----
  allow_missing_db = false  // DB_CHECK fails the run before any compute when a required database is absent;
                            // true downgrades that to a warning (dependent stages record `skipped`)
  provenance_hash_images = true  // onComplete: sha256 every .sif/.img that ran (≈1-2 min for the ~30 GB set);
                                 // false records path + size only
  image_cache_dir = null    // where public images are cached for apptainer/singularity (defaults to
                            // $NXF_APPTAINER_CACHEDIR / $NXF_SINGULARITY_CACHEDIR, then <work>/singularity);
                            // set it in site.config alongside apptainer.cacheDir

  // ---- container images for the two fungiforge-built images (not on Docker Hub) ----
  // Default: Docker tags (local docker build). On HPC point these at .sif files built
  // from env/Dockerfile + env/antismash-ff.Dockerfile (see docs/hpc_deployment.md).
  fungiforge_image = 'aduton1000/fungiforge:0.2.0'
  antismash_image  = 'aduton1000/antismash-ff:8.0.0-r3'

  // ---- compute caps ----
  max_cpus      = 16
  max_memory    = '120.GB'
  max_time      = '96.h'   // fungal annotation is slow, esp. emulated
}

process {
  cpus   = { Math.min(4  * task.attempt, params.max_cpus as int) }
  memory = { (8.GB * task.attempt) }
  time   = { (4.h  * task.attempt) }
  errorStrategy = { task.exitStatus in [137,139,140,143,247] ? 'retry' : 'finish' }
  maxRetries = 2
}

profiles {
  // ---- execution ----
  local     { process.executor = 'local' }
  hpc_slurm { includeConfig 'conf/hpc_slurm.config' }
  // ---- packaging ----
  conda      { conda.enabled = true;  conda.useMamba = false }
  mamba      { conda.enabled = true;  conda.useMamba = true  }
  // -e HOME/USER so tools that call getpass.getuser()/expanduser (medaka/torch, funannotate)
  // don't crash on a host UID that isn't in the container's /etc/passwd. The `-v data_dir`
  // is essential: Nextflow auto-mounts the project + work dirs but NOT --data_dir, so the
  // reference DBs (UNITE, FungAMR, BUSCO, funannotate) are invisible to containers without it.
  // Quoted to survive spaces in the path (e.g. an external drive whose mount path contains spaces).
  docker     { docker.enabled = true; docker.runOptions = '--platform linux/amd64 -u $(id -u):$(id -g) -e HOME=/tmp -e USER=fungiforge' + (params.data_dir ? " -v \"${params.data_dir}\":\"${params.data_dir}\"" : '') + (params.funannotate_db ? " -v \"${params.funannotate_db}\":\"${params.funannotate_db}\"" : '') + (params.antismash_db ? " -v \"${params.antismash_db}\":\"${params.antismash_db}\"" : '') + (params.genemark_dir ? " -v \"${params.genemark_dir}\":\"${params.genemark_dir}\"" : '') + (params.genemark_key ? " -v \"${new File(params.genemark_key.toString()).parent}\":\"${new File(params.genemark_key.toString()).parent}\"" : '')
               // antismash/standalone sets ENTRYPOINT ["antismash"], which hijacks Nextflow's bash launch
               // command under docker — clear it (docker-only flag; apptainer `exec` ignores ENTRYPOINT).
               // every task gets its own /tmp inside the container (see the apptainer note below)
               process { beforeScript = 'mkdir -p tmp'; containerOptions = { "-v \"${task.workDir}/tmp\":/tmp" }
                         withLabel: bgc { containerOptions = { "--entrypoint=\"\" -v \"${task.workDir}/tmp\":/tmp" } }
                         // interpro/interproscan also sets an ENTRYPOINT; its data release is mounted where the image expects it
                         withLabel: interproscan { containerOptions = {
                           // The data release lives in a versioned directory; fetch_references.sh leaves a
                           // stable <data_dir>/interproscan/data symlink so nothing here has to know the
                           // version. Bind only when it exists: binding a missing path aborts the container.
                           def d = params.interproscan_data ?: (params.data_dir ? "${params.data_dir}/interproscan/data" : null)
                           "--entrypoint=\"\" -v \"${task.workDir}/tmp\":/tmp" + ((d && new File(d.toString()).isDirectory()) ? " -v \"${d}\":/opt/interproscan/data" : '')
                         } } } }
  // pullTimeout: the funannotate image is ~15 GB; Nextflow's 20-min default aborts the pull.
  // Binds: Nextflow auto-mounts the task work dir and the pipeline bin/ — NOT the rest of the
  // repo (params.af_panel, test fixtures) nor --data_dir, so both are bound here. Site-wide
  // extra binds (APPTAINER_BIND / SINGULARITY_BIND from fungiforge-run) only reach the engine
  // if whitelisted: Nextflow launches containers with a scrubbed environment.
  singularity{ singularity.enabled = true; singularity.autoMounts = true; singularity.pullTimeout = '4 h'
               singularity.envWhitelist = 'SINGULARITY_BIND,SINGULARITY_BINDPATH,APPTAINER_BIND,APPTAINER_BINDPATH'
               singularity.runOptions = "-B \"${projectDir}\"" + (params.data_dir ? " -B \"${params.data_dir}\"" : '') + (params.genemark_dir ? " -B \"${params.genemark_dir}\"" : '') + (params.genemark_key ? " -B \"${new File(params.genemark_key.toString()).parent}\"" : '')
               process { beforeScript = 'mkdir -p tmp'; containerOptions = { "-B \"${task.workDir}/tmp\":/tmp" }
                         withLabel: interproscan { containerOptions = {
                           def d = params.interproscan_data ?: (params.data_dir ? "${params.data_dir}/interproscan/data" : null)
                           "-B \"${task.workDir}/tmp\":/tmp" + ((d && new File(d.toString()).isDirectory()) ? " -B \"${d}\":/opt/interproscan/data" : '')
                         } } } }
  apptainer  { apptainer.enabled  = true; apptainer.autoMounts  = true; apptainer.pullTimeout  = '4 h'
               apptainer.envWhitelist  = 'SINGULARITY_BIND,SINGULARITY_BINDPATH,APPTAINER_BIND,APPTAINER_BINDPATH'
               apptainer.runOptions  = "-B \"${projectDir}\"" + (params.data_dir ? " -B \"${params.data_dir}\"" : '') + (params.genemark_dir ? " -B \"${params.genemark_dir}\"" : '') + (params.genemark_key ? " -B \"${new File(params.genemark_key.toString()).parent}\"" : '')
               // The container's /tmp is the node's /tmp (a RAM tmpfs on many clusters, shared by every task on
               // the node). funannotate's protein-mapping helper writes tens of GB of exonerate output under a
               // hard-coded /tmp and ignores TMPDIR; once that tmpfs is full, every other tool that touches /tmp
               // (barrnap/nhmmer, BUSCO, antiSMASH, ...) fails with ENOSPC too. So EVERY task gets its own /tmp: a
               // 'tmp' directory created in the task work dir (on the shared disk, cleaned with the work dir) and
               // bound over /tmp for that container only. beforeScript runs on the host before the container starts.
               process { beforeScript = 'mkdir -p tmp'; containerOptions = { "-B \"${task.workDir}/tmp\":/tmp" }
                         withLabel: interproscan { containerOptions = {
                           def d = params.interproscan_data ?: (params.data_dir ? "${params.data_dir}/interproscan/data" : null)
                           "-B \"${task.workDir}/tmp\":/tmp" + ((d && new File(d.toString()).isDirectory()) ? " -B \"${d}\":/opt/interproscan/data" : '')
                         } } } }
  // ---- test ----
  test       { includeConfig 'conf/test.config' }
}

// base.config (labels -> env/container + resources) loaded AFTER profiles so its
// withLabel resource values are the baseline; hpc_slurm overrides executor only.
includeConfig 'conf/base.config'

report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report.html"; overwrite = true }
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
// `container` is in the trace so provenance.json can tell which images actually ran (the
// config's container map also lists selectors a site config overrides).
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt"; overwrite = true
           fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,container' }
