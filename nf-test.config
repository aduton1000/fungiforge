// nf-test configuration (https://www.nf-test.com). Run from the repo root:
//   nf-test test                     # everything under test/nf-test
//   nf-test test test/nf-test/pipeline.nf.test
// Every case runs Nextflow with -stub-run through the pipeline's own config and the
// `local,test` profiles (three-mode read fixture, empty mini database, DB_CHECK warns).
config {
    testsDir "test/nf-test"
    workDir ".nf-test"
    configFile "nextflow.config"
    profile "local,test"
}
