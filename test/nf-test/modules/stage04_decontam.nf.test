// Stub test for modules/stage04_decontam.nf — the process must run under -stub-run and emit every
// declared output once, named after the sample (the contract the subworkflow joins on).
nextflow_process {

    name "DECONTAM stub"
    script "modules/stage04_decontam.nf"
    process "DECONTAM"
    options "-stub-run"

    test("emits every declared output for one isolate") {
        when {
            process {
                """
                input[0] = [[id:'S1', assembly_mode:'longread', compartment:'AIR', facility:'F1', season:'Dry'], file("$baseDir/test/samplesheet.test.csv")]
                """
            }
        }
        then {
            assert process.success
            assert process.out.nuclear.size() == 1
            assert process.out.nuclear[0][1].endsWith('S1.nuclear.fasta')
            assert path(process.out.nuclear[0][1]).exists()
            assert process.out.mito.size() == 1
            assert process.out.mito[0][1].endsWith('S1.mito.fasta')
            assert path(process.out.mito[0][1]).exists()
            assert process.out.json.size() == 1
            assert process.out.json[0][1].endsWith('S1.decontam.json')
            assert path(process.out.json[0][1]).exists()
            def js = path(process.out.json[0][1]).json
            assert js.sample == 'S1'
        }
    }
}
