// Stub test for modules/stage07b_eggnog.nf — the process must run under -stub-run and emit every declared output (W2.5).
nextflow_process {

    name "EGGNOG stub"
    script "modules/stage07b_eggnog.nf"
    process "EGGNOG"
    options "-stub-run"

    test("emits every declared output for one isolate") {
        when {
            process {
                """
                input[0] = [[id:'S1', assembly_mode:'longread', compartment:'AIR', facility:'F1', season:'Dry'], file("$baseDir/test/samplesheet.test.csv")]
                """
            }
        }
        then {
            assert process.success
            assert process.out.json.size() == 1
            assert process.out.annotations[0][1].endsWith('S1.emapper.annotations')
            assert path(process.out.json[0][1]).json.stage == 'eggnog'
        }
    }
}
