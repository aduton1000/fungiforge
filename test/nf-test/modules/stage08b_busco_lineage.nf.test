// Stub test for modules/stage08b_busco_lineage.nf — species-aware BUSCO re-scoring (W2.3).
nextflow_process {

    name "BUSCO_LINEAGE stub"
    script "modules/stage08b_busco_lineage.nf"
    process "BUSCO_LINEAGE"
    options "-stub-run"

    test("emits the busco_lineage JSON for one isolate") {
        when {
            process {
                """
                input[0] = [[id:'S1', assembly_mode:'longread', compartment:'AIR', facility:'F1', season:'Dry'], file("$baseDir/test/samplesheet.test.csv"), file("$baseDir/nf-test.config")]
                """
            }
        }
        then {
            assert process.success
            assert process.out.json.size() == 1
            assert process.out.json[0][1].endsWith('S1.busco_lineage.json')
            def js = path(process.out.json[0][1]).json
            assert js.sample == 'S1' && js.stage == 'busco_lineage'
        }
    }
}
