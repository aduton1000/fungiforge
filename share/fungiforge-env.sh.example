# shellcheck shell=bash
# ─────────────────────────────────────────────────────────────────────────────
#  fungiforge — site environment (EXAMPLE). bin/hpc_install.sh writes a filled-in
#  copy to <install_root>/fungiforge-env.sh; users get it via /etc/profile.d or
#  `source` in ~/.bashrc. After sourcing, `fungiforge`, `fungiforge-run`,
#  `fungiforge-preflight` and `fungiforge-fetch-refs` are on PATH, so a run is:
#
#      cd ~/runs/batch1 && fungiforge-run --samplesheet samples.csv --outdir results
#
#  Layout this file assumes (mirrors callforge / captureforge on the same cluster):
#      <install_root>/repo        git checkout (main.nf, bin/, share/, conf/)
#      <install_root>/images      fungiforge-0.1.0.sif, antismash-ff-8.0.0-r3.sif, cache/
#      <install_root>/cli-env     conda env with the `fungiforge` Python CLI
#      <install_root>/site.config nextflow -c overrides (caps, image paths, partition)
#      <db_root>                  reference databases (bin/fetch_references.sh target)
# ─────────────────────────────────────────────────────────────────────────────

export FUNGIFORGE_ROOT="/hpc/opt/fungiforge"                          # [EDIT] install root
export FUNGIFORGE_HOME="$FUNGIFORGE_ROOT/repo"                        # repo checkout
export FUNGIFORGE_DB="/hpc/data/fungiforge"                           # [EDIT] reference DBs (150–250 GB)

# Per-user run scratch. Left UNSET on purpose: fungiforge-run then uses `work/` inside the
# directory you launch from, so each project keeps its own cache and `-resume` works per project.
# One shared work dir across projects mixes runs and quietly invalidates resumes when you switch.
# Set it only to move scratch off the launch directory, and then set it per project, not globally.
# Unset explicitly, not merely left unassigned: another install's env file may already have
# exported a global value, and it would survive into this one. It did — a development run wrote
# its work directory into the production scratch path.
unset FUNGIFORGE_WORK
# export FUNGIFORGE_WORK="$HOME/fungiforge_work"

# Container engine + SLURM routing. Empty partition = cluster default (sinfo shows it with *).
export FUNGIFORGE_ENGINE="apptainer"                                  # apptainer | singularity
export FUNGIFORGE_PARTITION=""                                        # e.g. "global"
export FUNGIFORGE_ACCOUNT=""                                          # e.g. "pi_adu"

# Site nextflow overrides (resource caps, .sif paths) and the shared image cache.
export FUNGIFORGE_SITE_CONFIG="$FUNGIFORGE_ROOT/site.config"
export FUNGIFORGE_IMAGE_CACHE="$FUNGIFORGE_ROOT/images/cache"

# Licensed GeneMark-ES (Appendix A of the upgrade plan): staged by hand, fixed per cluster.
# fungiforge-run passes these as --genemark_dir / --genemark_key unless the command line does.
export FUNGIFORGE_GENEMARK_DIR=""                                     # [EDIT] e.g. /hpc/opt/licensed/genemark/gmes_linux_64_4
export FUNGIFORGE_GENEMARK_KEY=""                                     # [EDIT] e.g. /hpc/opt/licensed/genemark/gm_key

# Extra host roots to bind into task containers (DB + work dir are always bound).
export FUNGIFORGE_BIND="/hpc"                                         # [EDIT or leave empty]

# PATH: wrappers first, then repo helpers (preflight_qc.sh, fetch_references.sh, *.py).
# Drop any OTHER fungiforge install's launchers first. A site can carry two (a production install
# hooked in through /etc/profile.d and a development one sourced from ~/.bashrc), and with both on
# PATH `fungiforge-run` resolves by accident of sourcing order, which differs between login and
# interactive shells. That silently ran a development command against the production pipeline,
# config and work directory. Whichever env file is sourced LAST now wins outright.
_ff_prune_path() {
  local _out="" _p _old_ifs="$IFS"
  IFS=:; set -- $PATH; IFS="$_old_ifs"
  for _p in "$@"; do
    case "$_p" in
      */fungiforge*/bin) continue ;;   # covers <root>/bin and <root>/repo/{share/,}bin
    esac
    _out="${_out:+$_out:}$_p"
  done
  PATH="$_out"
}
_ff_prune_path; unset -f _ff_prune_path
export PATH="$FUNGIFORGE_ROOT/bin:$FUNGIFORGE_HOME/share/bin:$FUNGIFORGE_HOME/bin:$PATH"

# Nextflow's own state stays per-user (the shared install is read-only).
export NXF_HOME="${NXF_HOME:-$HOME/.nextflow}"
