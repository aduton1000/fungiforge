# fungiforge base image for HPC (Apptainer/Singularity — Docker is often banned there).
#   apptainer build fungiforge.sif env/fungiforge.def
Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%files
    env/base.linux-64.lock /tmp/base.lock
    pyproject.toml /opt/fungiforge/pyproject.toml
    README.md /opt/fungiforge/README.md
    fungiforge /opt/fungiforge/fungiforge
    bin /opt/fungiforge/bin

%post
    export LC_ALL=C.UTF-8 LANG=C.UTF-8
    micromamba install -y -n base -f /tmp/base.lock && micromamba clean -a -y
    export PATH=/opt/conda/bin:$PATH
    pip install --no-cache-dir -e /opt/fungiforge
    chmod +x /opt/fungiforge/bin/*.py 2>/dev/null || true

%environment
    export PATH=/opt/conda/bin:$PATH
    export LC_ALL=C.UTF-8 LANG=C.UTF-8 MPLCONFIGDIR=/tmp/matplotlib
